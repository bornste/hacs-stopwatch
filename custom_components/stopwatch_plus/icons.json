{
  "entity": {
    "button": {
      "start": {
        "default": "mdi:play"
      },
      "pause": {
        "default": "mdi:pause"
      },
      "stop": {
        "default": "mdi:stop"
      },
      "reset": {
        "default": "mdi:restore"
      },
      "toggle": {
        "default": "mdi:play-pause"
      }
    },
    "sensor": {
      "elapsed": {
        "default": "mdi:timer-outline"
      },
      "status": {
        "default": "mdi:timer-cog-outline",
        "state": {
          "idle": "mdi:timer-off-outline",
          "running": "mdi:timer-play-outline",
          "paused": "mdi:timer-pause-outline"
        }
      },
      "last_session": {
        "default": "mdi:history"
      }
    },
    "event": {
      "events": {
        "default": "mdi:timer-alert-outline"
      }
    }
  },
  "services": {
    "start": {
      "service": "mdi:play"
    },
    "pause": {
      "service": "mdi:pause"
    },
    "stop": {
      "service": "mdi:stop"
    },
    "reset": {
      "service": "mdi:restore"
    },
    "toggle": {
      "service": "mdi:play-pause"
